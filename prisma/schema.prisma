// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique(map: "product_slug_idx")
  category    String
  image       String
  brand       String
  description String
  stock       Int
  price       Int         @default(0)
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
}

// https://authjs.dev/getting-started/adapters/prisma
model User {
  id            String    @id @default(uuid())
  name          String    @default("NO_NAME")
  email         String?   @unique(map: "user_email_idx")
  mobile        String?   @unique
  password      String?
  image         String?
  role          String    @default("user")
  address       Json?
  paymentMethod String?
  createdAt     DateTime  @default(now())
  updateAt      DateTime  @updatedAt
  account       Account[]
  session       Session[]
  cart          Cart[]
  orders        Order[]
}

// https://authjs.dev/getting-started/adapters/prisma
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// https://authjs.dev/getting-started/adapters/prisma
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String   @default(uuid())
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

// https://authjs.dev/getting-started/adapters/prisma
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Save cart and cart items in the database
model Cart {
  id            String   @id @default(uuid())
  userId        String?  @default(uuid())
  sessionCartId String
  items         Json
  itemsPrice    Int      @default(0)
  shippingPrice Int      @default(0)
  totalPrice    Int      @default(0)
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Save orders in the database
model Order {
  id              String    @id @default(uuid())
  userId          String    @default(uuid())
  shippingAddress Json
  paymentMethod   String
  paymentResult   Json?
  itemsPrice      Int       @default(0)
  shippingPrice   Int       @default(0)
  totalPrice      Int       @default(0)
  paidAt          DateTime?
  isPaid          Boolean   @default(false)
  deliveredAt     DateTime?
  isDelivered     Boolean   @default(false)
  createdAt       DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
}

// Save one order in the database
model OrderItem {
  orderId   String  @default(uuid())
  productId String  @default(uuid())
  name      String
  slug      String
  image     String
  qty       Int
  price     Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([orderId, productId])
}
